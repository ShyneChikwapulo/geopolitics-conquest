# Login gate (required for the submission's "username/password" requirement).
# If unset, defaults to student / inf4001n.
VITE_APP_USER=student
VITE_APP_PASS=inf4001n

# Optional. Without this, battle commentary uses a templated fallback sentence.
VITE_OPENROUTER_KEY=

# Required to actually use Firebase Firestore (the NoSQL database requirement).
# Create a project at https://console.firebase.google.com → Add app → Web → copy the config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=