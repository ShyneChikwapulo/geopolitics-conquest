# ---- Firebase (the NoSQL database + sign-in) -------------------------------------------------------------
# Console -> Project settings -> Your apps -> Web app. These values are PUBLIC by design; security comes from
# firestore.rules. Without them a production build cannot sign anyone in (local `npm run dev` offers a guest).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---- AI (optional) ---------------------------------------------------------------------------------------
# RECOMMENDED: a proxy that holds the key server-side (see infra/llm-proxy/README.md). Leave the key empty.
VITE_LLM_PROXY_URL=
# Model name sent to OpenRouter (free-model router by default).
VITE_LLM_MODEL=openrouter/free

# DEVELOPMENT ONLY. A key here is compiled into the public bundle and can be copied by any visitor.
# Never set this on a deployed site; use VITE_LLM_PROXY_URL instead.
VITE_OPENROUTER_KEY=
